# Copy to .env. Never commit real secrets.
VC_JWT_SECRET=change-me-to-a-long-random-string
# auto = Claude when ANTHROPIC_API_KEY is set, Gemini when a Gemini key is set, otherwise the deterministic offline provider
# auto | mock | anthropic | gemini
VC_LLM_PROVIDER=gemini
VC_ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...   (synthetic demo data only)
# Gemini model chain: on a quota error (429) the next model is used, then the offline rule engine.
VC_GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
# VC_GEMINI_API_KEY=...   (synthetic demo data only)
VC_DATABASE_URL=sqlite:///./vitalcontext.db
VC_FHIR_BACKEND=local
# VC_FHIR_BACKEND=hapi
# VC_FHIR_BASE_URL=http://localhost:8080/fhir
# VC_REDIS_URL=redis://localhost:6379/0
VC_DEMO_TODAY=2026-10-05
VC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
